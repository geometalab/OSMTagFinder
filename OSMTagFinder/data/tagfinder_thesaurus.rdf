  <skos:Concept rdf:about="http://wiki.openstreetmap.org/wiki/Tag:surface=stepping_stones">
    <skos:scopeNote xml:lang="de">Individuell platzierte Steine, die in regelmässigen Abständen eingestellt sind, um von einem zum nächsten zu treten, um zu vermeiden, dass Sie auf dem Boden unten gehen.  (Übersetzung)</skos:scopeNote>
    <osm:links rdf:resource="http://wiki.openstreetmap.org/wiki/Tag:ford=stepping_stones"/>
    <skos:editorialNote>NoTerm</skos:editorialNote>
