  <skos:Concept rdf:about="http://wiki.openstreetmap.org/wiki/Tag:place_of_worship=lourdes_grotto">
    <osm:links rdf:resource="http://wiki.openstreetmap.org/wiki/Key:subject:wikipedia"/>
    <skos:scopeNote xml:lang="de">Eine Lourdes-Grotte ist eine Nachbildung der ursprünglichen Grotte von Massabielle in der Nähe von Lourdes, Frankreich, wo Maria einem einheimischen Mädchen erschienen sein soll.  (Übersetzung)</skos:scopeNote>
    <osm:combines rdf:resource="http://wiki.openstreetmap.org/wiki/Key:subject:wikipedia"/>
    <osm:combines rdf:resource="http://wiki.openstreetmap.org/wiki/Key:name"/>
    <osm:combines rdf:resource="http://wiki.openstreetmap.org/wiki/Key:description"/>
    <osm:combines>year</osm:combines>
    <osm:way>{ "count": "112", "use": "True" }</osm:way>
    <osm:links rdf:resource="http://wiki.openstreetmap.org/wiki/Key:denomination"/>
    <osm:links rdf:resource="http://wiki.openstreetmap.org/wiki/Tag:tourism=attraction"/>
    <osm:links>loc_name</osm:links>
    <skos:broader rdf:resource="http://wiki.openstreetmap.org/wiki/Key:place_of_worship"/>
    <osm:links rdf:resource="http://wiki.openstreetmap.org/wiki/Tag:place_of_worship=lourdes_grotto"/>
    <foaf:depiction rdf:resource="https://upload.wikimedia.org/wikipedia/commons/8/8d/Yvoir_Grotte_ND_de_Lourdes_R01.jpg"/>
    <skos:editorialNote>NoTerm</skos:editorialNote>
    <skos:scopeNote xml:lang="en">A Lourdes Grotto is a replication of the original Grotto of Massabielle near Lourdes, France, where Maria is said to have appeared to a local girl. Such replications consist of a (usually man-made) cave or cave replica, sometimes lifesize, sometimes just a few decimetres high, with a statue of Maria inside.</skos:scopeNote>
    <osm:links>man_made=grotto</osm:links>
