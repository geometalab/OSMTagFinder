    <skos:broader rdf:resource="http://wiki.openstreetmap.org/wiki/Key:sport"/>
    <osm:node>{ "count": "21", "use": "True" }</osm:node>
    <skos:scopeNote xml:lang="en">Motorcycle speedway, usually referred to as speedway, is a motorcycle sport involving four and sometimes up to six riders competing over four anti-clockwise laps of an oval circuit.</skos:scopeNote>
    <osm:combines rdf:resource="http://wiki.openstreetmap.org/wiki/Tag:leisure=sports_centre"/>
    <skos:prefLabel>sport=speedway</skos:prefLabel>
