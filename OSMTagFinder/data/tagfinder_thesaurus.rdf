    <skos:broader rdf:resource="http://wiki.openstreetmap.org/wiki/Key:surface"/>
    <skos:scopeNote xml:lang="en">Individually placed stones set at regular intervals for stepping from one to the next, to avoid walking on the ground below. Commonly used for river or creek crossings, muddy crossings, or areas to preserve the grass from being trampled.</skos:scopeNote>
